# Odyssey AI - Environment Variables Configuration
# Copy this file to .env and fill in your actual values for deployment

# ============================================================================
# CORE CONFIGURATION
# ============================================================================

# Environment: development, staging, production
ODYSSEY_ENV=development

# Frontend API URL (required for frontend to connect to backend)
VITE_ODYSSEY_API_URL=http://localhost:8000

# Admin token for API authentication (Bearer token)
# Required for all state-changing and cost-incurring endpoints
# Generate a secure random token for production deployment
ODYSSEY_ADMIN_TOKEN=your-secure-admin-token-here

# Maximum request body size in bytes (default: 256KB)
ODYSSEY_MAX_BODY_BYTES=262144

# Data directory for local file storage (drafts, webhooks, etc.)
ODYSSEY_DATA_DIR=./.odyssey

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Comma-separated list of allowed CORS origins
# For cloud deployment, include your frontend domain
ODYSSEY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,https://odyssey-ai-frontend.vercel.app

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================================

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (has full database access)
# WARNING: Never commit this to version control
SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================================================
# GROQ API CONFIGURATION (REQUIRED FOR LLM FEATURES)
# ============================================================================

# Groq API key for LLM inference
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# ============================================================================
# ELEVENLABS CONFIGURATION (OPTIONAL - FOR TTS)
# ============================================================================

# ElevenLabs API key for text-to-speech
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Default ElevenLabs voice ID
# Get from: https://elevenlabs.io/app/voice-lab
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ============================================================================
# SMTP CONFIGURATION (OPTIONAL - FOR EMAIL SENDING)
# ============================================================================

# SMTP server host
ODYSSEY_SMTP_HOST=smtp.gmail.com

# SMTP server port (default: 587 for TLS)
ODYSSEY_SMTP_PORT=587

# SMTP username (usually email address)
ODYSSEY_SMTP_USER=your-email@gmail.com

# SMTP password or app-specific password
ODYSSEY_SMTP_PASS=your-app-password

# Default "from" email address (defaults to SMTP_USER if not set)
ODYSSEY_SMTP_FROM=your-email@gmail.com

# ============================================================================
# CLOUD DEPLOYMENT SPECIFIC (OPTIONAL)
# ============================================================================

# Cloud provider: vercel, railway, render, local
# Used for platform-specific optimizations
CLOUD_PROVIDER=local

# Application URL (for webhook callbacks, etc.)
APP_URL=http://localhost:8000

# ============================================================================
# MONITORING & LOGGING (OPTIONAL)
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable Sentry error tracking (optional)
SENTRY_DSN=

# ============================================================================
# RATE LIMITING (OPTIONAL)
# ============================================================================

# Rate limit requests per minute
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# WEBHOOK CONFIGURATION (OPTIONAL)
# ============================================================================

# Webhook secret for signature verification
WEBHOOK_SECRET=your-webhook-secret

# Webhook timeout in seconds
WEBHOOK_TIMEOUT=30
